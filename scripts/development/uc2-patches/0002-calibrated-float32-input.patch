+/**
+*  Read only the 3 selected bands of an already calibrated BSQ cube stored
+*  as float32 (ENVI data type 4), e.g. LCTF_Calibrated_Cube_Single.dat.
+*  Output order: Blue, Green, Red (same as extract_selected_bands_LCTF_BSQ).
+*/
+float *read_selected_bands_BSQ_float(const char *file, int numberOfLines, int numberOfSamples, int headerOffset, int red, int green, int blue){
+
+	size_t numberOfPixels = (size_t)numberOfLines * numberOfSamples;
+	int bandIndexes[SELECTED_BANDS] = {blue, green, red};
+
+	float *threeBands = (float *)malloc(numberOfPixels * SELECTED_BANDS * sizeof(float));
+	FILE *fp = fopen(file, "rb");
+	if (threeBands == NULL || fp == NULL) {
+		printf("Error opening/allocating '%s'\n", file);
+		exit(1);
+	}
+
+	for (int b = 0; b < SELECTED_BANDS; b++) {
+		long offset = (long)headerOffset + (long)bandIndexes[b] * (long)(numberOfPixels * sizeof(float));
+		if (fseek(fp, offset, SEEK_SET) != 0 ||
+			fread(threeBands + b * numberOfPixels, sizeof(float), numberOfPixels, fp) != numberOfPixels) {
+			printf("Error reading band %d from '%s'\n", bandIndexes[b], file);
+			exit(1);
+		}
+	}
+
+	fclose(fp);
+	return threeBands;
+}
