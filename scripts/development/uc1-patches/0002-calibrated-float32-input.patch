+// SLIAFlow patch 0002: read raw.dat as a float32 BSQ cube that is already
+// calibrated reflectance, and copy it to the device as it is stored. Unlike
+// the uint16 path, a short read or a failed allocation is reported, so the
+// caller can refuse the run instead of classifying an empty buffer.
+bool uploadCalibratedImage_float32(AppConfig *config, float **dev_calibratedImage) {
+    size_t imageBytes = config->numberOfLines * config->numberOfSamples * config->numberOfBands * sizeof(float);
+    FILE *fp = fopen(config->hsi_path, "rb");
+    if (!fp) {
+        fprintf(stderr, "Error: cannot open %s\n", config->hsi_path);
+        return false;
+    }
+    float *hostImage = nullptr;
+    if (cudaMallocHost((void**)&hostImage, imageBytes) != cudaSuccess) {
+        fprintf(stderr, "Error: cannot allocate %zu bytes of host memory for the cube\n", imageBytes);
+        fclose(fp);
+        return false;
+    }
+    size_t readBytes = fread(hostImage, 1, imageBytes, fp);
+    fclose(fp);
+    if (readBytes != imageBytes) {
+        fprintf(stderr, "Error: %s holds %zu bytes, the header describes %zu\n", config->hsi_path, readBytes, imageBytes);
+        cudaFreeHost(hostImage);
+        return false;
+    }
+    if (cudaMalloc((void**)dev_calibratedImage, imageBytes) != cudaSuccess) {
+        fprintf(stderr, "Error: cannot allocate %zu bytes of device memory for the cube\n", imageBytes);
+        cudaFreeHost(hostImage);
+        return false;
+    }
+    cudaMemcpy(*dev_calibratedImage, hostImage, imageBytes, cudaMemcpyHostToDevice);
+    cudaFreeHost(hostImage);
+    return true;
+}
