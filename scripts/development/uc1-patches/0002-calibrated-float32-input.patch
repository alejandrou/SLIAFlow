+// SLIAFlow patch 0002. The same tiled BSQ-to-BIP transpose as
+// calibrateAndConvertToBIP_Tiled, for a cube that is already calibrated
+// reflectance (1.0 = the white reference). It is multiplied by 100, the scale
+// UC1's own calibration writes, so every later stage sees the units it
+// sees on a uint16 cube.
+__global__ void scaleCalibratedAndConvertToBIP_Tiled(
+    float       * __restrict__ calibrateImageBIPOut,
+    const float * __restrict__ calibratedBSQ,
+    size_t numberOfBands,
+    size_t numberOfPixels)
+{
+    __shared__ float tile[TILE_DIM][TILE_DIM + 1];
+
+    int pixelIdx = blockIdx.x * TILE_DIM + threadIdx.x;
+    int bandIdx  = blockIdx.y * TILE_DIM + threadIdx.y;
+
+    for (int j = 0; j < TILE_DIM; j += BLOCK_ROWS) {
+        int b = bandIdx + j;
+        if (pixelIdx < numberOfPixels && b < numberOfBands) {
+            tile[threadIdx.y + j][threadIdx.x] = 100.0f * calibratedBSQ[(size_t)b * numberOfPixels + pixelIdx];
+        }
+    }
+    __syncthreads();
+
+    int bandWrite  = blockIdx.y * TILE_DIM + threadIdx.x;
+    int pixelWrite = blockIdx.x * TILE_DIM + threadIdx.y;
+
+    for (int j = 0; j < TILE_DIM; j += BLOCK_ROWS) {
+        if ((pixelWrite + j) < numberOfPixels && bandWrite < numberOfBands) {
+            calibrateImageBIPOut[(size_t)(pixelWrite + j) * numberOfBands + bandWrite] = tile[threadIdx.x][threadIdx.y + j];
+        }
+    }
+}
